[Desktop Entry]
Type=Application
Name=tmssh
GenericName=SSH Session Manager
Comment=Tiny managed SSH: a session manager and ssh terminal on gtkpyte
Exec=@bindir@/tmssh
Icon=io.github.scottpeterman.tmssh
Terminal=false
Categories=Network;RemoteAccess;GTK;
StartupWMClass=io.github.scottpeterman.tmssh
StartupNotify=true
