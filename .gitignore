# --- build output -------------------------------------------------------------
# scripts/build.sh: build/, build-release/; scripts/appimage.sh: build-appimage/
build/
build-*/

# --- AppImage ------------------------------------------------------------------
# linuxdeploy and its GTK plugin, fetched by scripts/appimage.sh
.appimage-tools/
# packaged AppImages; these go on GitHub Releases, not in the tree
dist/
*.AppImage
*.AppImage.zsync
AppDir/
squashfs-root/

# --- meson ---------------------------------------------------------------------
# subprojects fetched from the .wrap files; the wraps and packagefiles stay
subprojects/*/
!subprojects/packagefiles/
subprojects/packagecache/
meson-logs/
meson-private/

# --- compiler and tool output ---------------------------------------------------
*.o
*.a
*.so
*.so.*
*.d
*.gch
*.pch
compile_commands.json
.cache/

# --- editors and OS -------------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store

# --- stray runtime files --------------------------------------------------------
*.log
*.tmp
*.bak
